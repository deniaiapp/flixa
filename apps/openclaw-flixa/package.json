{
  "name": "@deniai/openclaw-flixa",
  "version": "0.4.1",
  "description": "Run Flixa Ship as an OpenClaw CLI backend.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deniaiapp/flixa.git",
    "directory": "apps/openclaw-flixa"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "sync-version": "node scripts/sync-version.mjs",
    "prebuild": "pnpm run sync-version",
    "build": "tsc -p tsconfig.json",
    "smoke": "node scripts/smoke.mjs",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "openclaw": "2026.7.1",
    "typescript": "^7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}

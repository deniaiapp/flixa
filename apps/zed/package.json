{
  "name": "@deniai/flixa-zed",
  "version": "0.8.4",
  "description": "Flixa ACP agent for Zed",
  "homepage": "https://deniai.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deniaiapp/flixa.git",
    "directory": "apps/zed"
  },
  "bin": {
    "flixa-zed": "dist/flixa-zed.js"
  },
  "files": [
    "dist/flixa-zed.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild ./src/index.ts --bundle --outfile=./dist/flixa-zed.js --platform=node --format=esm --minify && esbuild ./src/flixa-acp.ts --bundle --outdir=./dist --platform=node --format=esm --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run acp:check && pnpm run typecheck && vitest run && pnpm run build",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "acp:sync": "node scripts/sync-acp-manifest.mjs",
    "acp:check": "node scripts/sync-acp-manifest.mjs --check"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@deniai/flixa-api-client": "workspace:*",
    "@deniai/flixa-core": "workspace:*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26"
  }
}

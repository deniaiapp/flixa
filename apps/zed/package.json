{
  "name": "@deniai/flixa-zed",
  "version": "0.8.4",
  "description": "Flixa ACP agent for Zed",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deniai-app/flixa.git"
  },
  "homepage": "https://deniai.app",
  "type": "module",
  "files": [
    "dist/flixa-zed.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "flixa-zed": "dist/flixa-zed.js"
  },
  "scripts": {
    "build": "esbuild ./src/index.ts --bundle --outfile=./dist/flixa-zed.js --platform=node --format=esm --minify && esbuild ./src/flixa-acp.ts --bundle --outdir=./dist --platform=node --format=esm --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck && vitest run && pnpm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

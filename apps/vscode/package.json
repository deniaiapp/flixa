{
  "name": "flixa",
  "displayName": "Flixa",
  "version": "0.9.5",
  "description": "AI-powered code implementation assistant",
  "categories": [
    "AI",
    "Chat",
    "Education",
    "Machine Learning",
    "Other",
    "Programming Languages",
    "Testing"
  ],
  "keywords": [
    "agent",
    "ai",
    "chatgpt",
    "claude",
    "claude code",
    "cline",
    "codex",
    "coding",
    "copilot",
    "github",
    "gpt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deniaiapp/flixa",
    "directory": "apps/vscode"
  },
  "publisher": "deniai",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/deniaiapp/flixa/blob/HEAD/apps/vscode --baseImagesUrl https://github.com/deniaiapp/flixa/raw/HEAD/apps/vscode --out flixa.vsix",
    "publish": "pnpm run package && pnpm run --no-bail \"/^publish:(vscode|openvsx)$/\"",
    "publish:vscode": "vsce publish --packagePath flixa.vsix",
    "publish:openvsx": "ovsx publish flixa.vsix",
    "compile": "cd webview-ui && pnpm run build && cd .. && pnpm run build:ext",
    "build:ext": "esbuild ./src/extension.ts --bundle --outdir=./out --platform=node --format=cjs --minify --external:vscode",
    "build:webview": "cd webview-ui && pnpm run build",
    "watch": "tsc -watch -p ./",
    "lint": "oxlint -c ../../.oxlintrc.json src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm run compile",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.104",
    "@ai-sdk/openai": "^4.0.117",
    "@anthropic-ai/sdk": "^1.8.0",
    "ai": "^7.0.172",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@deniai/flixa-api-client": "workspace:*",
    "@deniai/flixa-core": "workspace:*",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.6",
    "@types/vscode": "1.107.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "ovsx": "^1.4.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "contributes": {
    "configuration": {
      "title": "Flixa",
      "properties": {
        "flixa.agentApprovalMode": {
          "type": "string",
          "default": "SAFE_APPROVE",
          "enum": [
            "ALL_APPROVE",
            "AUTO_APPROVE",
            "SAFE_APPROVE",
            "MANUAL_APPROVE"
          ],
          "enumDescriptions": [
            "Execute all actions immediately without confirmation",
            "AI safety check for shell commands, auto-execute others",
            "User confirmation for shell commands, auto-execute others",
            "User confirmation required for all actions"
          ],
          "description": "Approval mode for agent actions"
        },
        "flixa.autoContext.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic workspace and active file context in AI prompts"
        },
        "flixa.autoContext.includeFileList": {
          "type": "boolean",
          "default": true,
          "description": "Include file list in auto context"
        },
        "flixa.autoContext.includeGitStatus": {
          "type": "boolean",
          "default": true,
          "description": "Include git status in auto context"
        },
        "flixa.autoContext.includePackageInfo": {
          "type": "boolean",
          "default": true,
          "description": "Include package.json info in auto context"
        },
        "flixa.autoContext.includeTsConfig": {
          "type": "boolean",
          "default": true,
          "description": "Include tsconfig.json info in auto context"
        },
        "flixa.autoContext.maxFileListDepth": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum depth for file list traversal"
        },
        "flixa.autoContext.maxFiles": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "maximum": 2000,
          "description": "Maximum number of files to include in file list"
        },
        "flixa.autoContext.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "dist",
            "out",
            "build",
            ".next",
            ".nuxt",
            "coverage",
            ".cache",
            ".vscode",
            ".idea",
            "__pycache__",
            ".pytest_cache",
            "*.log",
            "*.lock",
            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml",
            "bun.lock",
            "bun.lockb"
          ],
          "description": "Patterns to exclude from file list"
        },
        "flixa.compactTokenThreshold": {
          "type": "number",
          "default": 200000,
          "minimum": 0,
          "description": "Estimated input token threshold for context compaction. When the agent context reaches this size, Flixa asks the model to summarize the conversation and continues from the summary. Set to 0 to disable automatic compaction."
        }
      }
    },
    "commands": [
      {
        "command": "flixa.implementComment",
        "title": "Flixa: Implement Comment"
      },
      {
        "command": "flixa.openChat",
        "title": "Flixa: Open Chat"
      },
      {
        "command": "flixa.newChat",
        "title": "Flixa: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "flixa.showChatHistory",
        "title": "Flixa: Chat History",
        "icon": "$(history)"
      },
      {
        "command": "flixa.openPlan",
        "title": "Plan"
      },
      {
        "command": "flixa.openSettings",
        "title": "Open Settings"
      },
      {
        "command": "flixa.applyDiff",
        "title": "Flixa: Apply Diff"
      },
      {
        "command": "flixa.inlineEdit",
        "title": "Flixa: Inline Edit"
      },
      {
        "command": "flixa.toggleAgentMode",
        "title": "Flixa: Toggle Agent Mode"
      },
      {
        "command": "flixa.setApprovalMode",
        "title": "Flixa: Set Approval Mode"
      },
      {
        "command": "flixa.showUsageDetail",
        "title": "Usage"
      },
      {
        "command": "flixa.login",
        "title": "Deni AI: Login"
      },
      {
        "command": "flixa.logout",
        "title": "Deni AI: Logout"
      },
      {
        "command": "flixa.refreshUsage",
        "title": "Deni AI: Refresh Usage"
      }
    ],
    "keybindings": [
      {
        "command": "flixa.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flixa-sidebar",
          "title": "Flixa",
          "icon": "assets/flixa-sidebar.svg"
        }
      ]
    },
    "views": {
      "flixa-sidebar": [
        {
          "type": "webview",
          "id": "flixa.chatView",
          "name": "Chat",
          "icon": "assets/flixa-sidebar.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "flixa.chatSettings",
        "label": "Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flixa.showChatHistory",
          "when": "view == flixa.chatView",
          "group": "navigation@1"
        },
        {
          "command": "flixa.newChat",
          "when": "view == flixa.chatView",
          "group": "navigation@2"
        },
        {
          "submenu": "flixa.chatSettings",
          "when": "view == flixa.chatView",
          "group": "navigation@3"
        }
      ],
      "flixa.chatSettings": [
        {
          "command": "flixa.showUsageDetail",
          "group": "navigation@1"
        },
        {
          "command": "flixa.openPlan",
          "group": "navigation@2"
        },
        {
          "command": "flixa.openSettings",
          "group": "navigation@3"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "assets/flixa.png",
  "engines": {
    "vscode": "^1.107.0"
  }
}

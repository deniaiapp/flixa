{
  "name": "@deniai/flixa",
  "version": "0.4.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deniaiapp/flixa.git",
    "directory": "apps/cli"
  },
  "bin": {
    "flixa": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "providers:update": "node scripts/update-models-dev.mjs",
    "openclaw:check": "node scripts/verify-openclaw-integration.mjs",
    "lint": "oxlint -c ../../.oxlintrc.json src scripts",
    "format": "oxfmt src scripts",
    "format:check": "oxfmt --check src scripts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run regression:check && pnpm run e2e:check && pnpm run build && pnpm run openclaw:check",
    "regression:check": "tsx scripts/verify-cli-regressions.ts",
    "build": "node scripts/build.mjs && node scripts/prepare-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run regression:check && pnpm run e2e:check",
    "e2e:check": "tsx scripts/verify-agent-e2e.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.88",
    "@ai-sdk/google": "4.0.105",
    "@ai-sdk/mistral": "4.0.72",
    "@ai-sdk/open-responses": "2.0.73",
    "@ai-sdk/openai": "^4.0.102",
    "@ai-sdk/openai-compatible": "3.0.78",
    "@ai-sdk/provider": "^4.0.34",
    "@inquirer/prompts": "^8.7.4",
    "@vscode/ripgrep": "^1.18.0",
    "ai": "^7.0.153",
    "boxen": "^9.0.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "ink": "^8.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "open": "^11.0.4",
    "react": "^19.3.1",
    "react-devtools-core": "^8.0.0"
  },
  "devDependencies": {
    "@deniai/flixa-api-client": "workspace:*",
    "@deniai/flixa-core": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "engines": {
    "node": ">=26"
  }
}

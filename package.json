{
  "name": "flixa",
  "displayName": "Flixa",
  "description": "AI-powered code implementation assistant",
  "version": "0.9.2",
  "publisher": "deniai",
  "icon": "assets/flixa.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/deniaiapp/flixa"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Education",
    "Machine Learning",
    "Testing",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "chatgpt",
    "claude",
    "cline",
    "codex",
    "copilot",
    "claude code",
    "github",
    "gpt",
    "agent",
    "coding"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Flixa",
      "properties": {
        "flixa.agentApprovalMode": {
          "type": "string",
          "default": "SAFE_APPROVE",
          "enum": [
            "ALL_APPROVE",
            "AUTO_APPROVE",
            "SAFE_APPROVE",
            "MANUAL_APPROVE"
          ],
          "enumDescriptions": [
            "Execute all actions immediately without confirmation",
            "AI safety check for shell commands, auto-execute others",
            "User confirmation for shell commands, auto-execute others",
            "User confirmation required for all actions"
          ],
          "description": "Approval mode for agent actions"
        },
        "flixa.autoContext.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic workspace and active file context in AI prompts"
        },
        "flixa.autoContext.includeFileList": {
          "type": "boolean",
          "default": true,
          "description": "Include file list in auto context"
        },
        "flixa.autoContext.includeGitStatus": {
          "type": "boolean",
          "default": true,
          "description": "Include git status in auto context"
        },
        "flixa.autoContext.includePackageInfo": {
          "type": "boolean",
          "default": true,
          "description": "Include package.json info in auto context"
        },
        "flixa.autoContext.includeTsConfig": {
          "type": "boolean",
          "default": true,
          "description": "Include tsconfig.json info in auto context"
        },
        "flixa.autoContext.maxFileListDepth": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum depth for file list traversal"
        },
        "flixa.autoContext.maxFiles": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "maximum": 2000,
          "description": "Maximum number of files to include in file list"
        },
        "flixa.autoContext.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules",
            ".git",
            "dist",
            "out",
            "build",
            ".next",
            ".nuxt",
            "coverage",
            ".cache",
            ".vscode",
            ".idea",
            "__pycache__",
            ".pytest_cache",
            "*.log",
            "*.lock",
            "package-lock.json",
            "yarn.lock",
            "pnpm-lock.yaml",
            "bun.lock",
            "bun.lockb"
          ],
          "description": "Patterns to exclude from file list"
        },
        "flixa.compactTokenThreshold": {
          "type": "number",
          "default": 200000,
          "minimum": 0,
          "description": "Estimated input token threshold for client-driven context compaction. When the agent context reaches this size, Flixa calls POST /v1/agent/responses/compact. Set to 0 to disable automatic compaction."
        }
      }
    },
    "commands": [
      {
        "command": "flixa.implementComment",
        "title": "Flixa: Implement Comment"
      },
      {
        "command": "flixa.openChat",
        "title": "Flixa: Open Chat"
      },
      {
        "command": "flixa.newChat",
        "title": "Flixa: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "flixa.showChatHistory",
        "title": "Flixa: Chat History",
        "icon": "$(history)"
      },
      {
        "command": "flixa.openPlan",
        "title": "Plan"
      },
      {
        "command": "flixa.openSettings",
        "title": "Open Settings"
      },
      {
        "command": "flixa.applyDiff",
        "title": "Flixa: Apply Diff"
      },
      {
        "command": "flixa.inlineEdit",
        "title": "Flixa: Inline Edit"
      },
      {
        "command": "flixa.toggleAgentMode",
        "title": "Flixa: Toggle Agent Mode"
      },
      {
        "command": "flixa.setApprovalMode",
        "title": "Flixa: Set Approval Mode"
      },
      {
        "command": "flixa.showUsageDetail",
        "title": "Usage"
      },
      {
        "command": "flixa.login",
        "title": "Deni AI: Login"
      },
      {
        "command": "flixa.logout",
        "title": "Deni AI: Logout"
      },
      {
        "command": "flixa.refreshUsage",
        "title": "Deni AI: Refresh Usage"
      }
    ],
    "keybindings": [
      {
        "command": "flixa.inlineEdit",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flixa-sidebar",
          "title": "Flixa",
          "icon": "assets/flixa-sidebar.svg"
        }
      ]
    },
    "views": {
      "flixa-sidebar": [
        {
          "type": "webview",
          "id": "flixa.chatView",
          "name": "Chat",
          "icon": "assets/flixa-sidebar.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "flixa.chatSettings",
        "label": "Settings",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "flixa.showChatHistory",
          "when": "view == flixa.chatView",
          "group": "navigation@1"
        },
        {
          "command": "flixa.newChat",
          "when": "view == flixa.chatView",
          "group": "navigation@2"
        },
        {
          "submenu": "flixa.chatSettings",
          "when": "view == flixa.chatView",
          "group": "navigation@3"
        }
      ],
      "flixa.chatSettings": [
        {
          "command": "flixa.showUsageDetail",
          "group": "navigation@1"
        },
        {
          "command": "flixa.openPlan",
          "group": "navigation@2"
        },
        {
          "command": "flixa.openSettings",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "package": "vsce package --no-dependencies --out flixa.vsix",
    "publish": "bun run package && bun run --parallel --no-exit-on-error publish:vscode publish:openvsx",
    "publish:vscode": "vsce publish --packagePath flixa.vsix",
    "publish:openvsx": "ovsx publish flixa.vsix",
    "compile": "cd webview-ui && npm run build && cd .. && bun run build:ext",
    "build:zed": "cd zed && bun run build",
    "build:ext": "bun build ./src/extension.ts --outdir ./out --target node --format cjs --minify --external vscode",
    "build:webview": "cd webview-ui && npm run build",
    "watch": "tsc -watch -p ./",
    "lint": "oxlint src",
    "test": "bun test src webview-ui/src",
    "test:watch": "bun test --watch src webview-ui/src",
    "test:coverage": "bun test --coverage src webview-ui/src"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.72",
    "@ai-sdk/openai": "^4.0.84",
    "@anthropic-ai/sdk": "^0.131.0",
    "ai": "^7.0.128",
    "oxfmt": "^0.72.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.4",
    "@types/vscode": "1.140.0",
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}

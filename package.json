{
  "name": "@deniai/flixa",
  "version": "0.4.1",
  "type": "module",
  "private": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "bin": {
    "flixa": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deniaiapp/flixa-cli.git"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "providers:update": "node scripts/update-models-dev.mjs",
    "openclaw:check": "node scripts/verify-openclaw-integration.mjs",
    "lint": "oxlint src scripts integrations/openclaw-flixa/src integrations/openclaw-flixa/scripts",
    "format": "oxfmt src scripts integrations/openclaw-flixa/src integrations/openclaw-flixa/scripts",
    "format:check": "oxfmt --check src scripts integrations/openclaw-flixa/src integrations/openclaw-flixa/scripts",
    "check": "pnpm exec tsc --noEmit && pnpm run lint && pnpm run format:check && pnpm run regression:check && pnpm run build && pnpm run openclaw:check",
    "regression:check": "tsx scripts/verify-cli-regressions.ts",
    "build": "node scripts/build.mjs && node scripts/prepare-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.12",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/google": "^3.0.55",
    "@ai-sdk/mistral": "3.0.74",
    "@ai-sdk/open-responses": "^1.0.8",
    "@ai-sdk/openai": "^3.0.49",
    "@ai-sdk/openai-compatible": "2.0.85",
    "@ai-sdk/provider": "^3.0.8",
    "@inquirer/prompts": "^8.3.2",
    "@vscode/ripgrep": "^1.15.14",
    "ai": "^6.0.142",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "open": "^11.0.0",
    "react": "^18.3.1",
    "react-devtools-core": "^6.1.5"
  },
  "packageManager": "pnpm@12.18.0"
}
